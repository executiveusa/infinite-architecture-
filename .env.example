# Infinite Architecture — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ─── DASHBOARD AUTH ──────────────────────────────────────────────────────────
# Simple key to gate the /dashboard route. Use a long random string.
DASHBOARD_SECRET=your-super-secret-dashboard-key-here

# ─── PI AGENT INTEGRATION ────────────────────────────────────────────────────
# The base URL of the Pi Agent backend (executiveusa/pauli-pi-agent)
PI_AGENT_BASE_URL=https://your-pi-agent-url.com
# API key for authenticating requests to Pi Agent
PI_AGENT_API_KEY=your-pi-agent-api-key-here

# ─── SITE-TO-STAY INQUIRY STORAGE ───────────────────────────────────────────
# Server-only Supabase project URL and new-format secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Public business contact number only, digits with country code. Never use +52... as a value.
NEXT_PUBLIC_WHATSAPP_NUMBER=521234567890

# ─── SUPABASE (legacy/future client features) ────────────────────────────────
# Existing placeholders retained for future client-side features. Prefer new publishable keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# ─── SOCIAL MEDIA API (future) ───────────────────────────────────────────────
# Instagram / Facebook
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
# X (Twitter)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
