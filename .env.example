# Infinite Architecture — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ─── DASHBOARD AUTH ──────────────────────────────────────────────────────────
# Simple key to gate the /dashboard route. Use a long random string.
DASHBOARD_SECRET=your-super-secret-dashboard-key-here

# ─── PI AGENT INTEGRATION ────────────────────────────────────────────────────
# The base URL of the Pi Agent backend (executiveusa/pauli-pi-agent)
PI_AGENT_BASE_URL=https://your-pi-agent-url.com
# API key for authenticating requests to Pi Agent
PI_AGENT_API_KEY=your-pi-agent-api-key-here

# ─── SUPABASE (production database) ─────────────────────────────────────────
# When migrating from filesystem JSON to Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── SOCIAL MEDIA API (future) ───────────────────────────────────────────────
# Instagram / Facebook
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
# X (Twitter)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
